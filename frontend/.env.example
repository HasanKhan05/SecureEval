# SecureEval Frontend Environment Configuration
# Copy this file to frontend/.env or set in your production build pipeline.
# Vite bakes VITE_* variables into client bundles at build time.

# Backend API base URL.
# In local development, defaults to http://127.0.0.1:8000 if unset.
# For production deployment, set to your backend origin (e.g. https://api.secureeval.yourdomain.com)
# or leave empty/omit if frontend and backend are reverse-proxied under the same origin.
VITE_SECUREEVAL_API_URL=http://127.0.0.1:8000
