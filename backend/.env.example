# SecureEval Backend Environment Configuration
# Copy this file to backend/.env and fill in your values.
# backend/.env is gitignored and will never be committed.

# Server Host & Port (production default: 0.0.0.0 and 8000)
SECUREEVAL_HOST=0.0.0.0
SECUREEVAL_PORT=8000

# Environment Mode (development or production)
SECUREEVAL_ENV=development

# Database URL
# SQLite is the tested default. PostgreSQL requires installing the appropriate driver (e.g., psycopg2).
SECUREEVAL_DATABASE_URL=sqlite:///./data/secureeval.db

# Storage root for uploaded artifacts
SECUREEVAL_ARTIFACT_ROOT=./data/artifacts

# Allowed CORS Origins (comma-separated list of allowed frontend origins)
# For local dev: http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173
# For production: https://secureeval.yourdomain.com
SECUREEVAL_ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# Git revision tag or label for provenance tracking
SECUREEVAL_SOURCE_REVISION=unavailable_local_checkout

# Tool execution timeout in seconds (Bandit, Semgrep, pytest)
SECUREEVAL_TOOL_TIMEOUT_SECONDS=60

# OmniRoute LLM Configuration
# Note: For remote deployment, OMNIROUTE_BASE_URL must be a network-reachable URL,
# not localhost unless OmniRoute runs inside the same host/container.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=
NORMAL_ASSISTANT_MODEL=auto/best-coding
EXPERIMENT_MODEL=gemini/gemini-3.1-flash-lite
